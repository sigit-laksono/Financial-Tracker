{
  "name": "financial-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun run --parallel dev:server dev:client",
    "dev:server": "bun --watch server/src/index.ts",
    "dev:client": "bun --bun vite",
    "start": "bun run server/src/index.ts",
    "build": "bun run build:client",
    "build:client": "bun --bun vite build",
    "typecheck": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p client/tsconfig.json",
    "lint": "bun --bun biome lint server/src client/src shared/src",
    "format": "bun --bun biome format --write server/src client/src shared/src",
    "test": "bun test",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun run server/src/db/migrate.ts",
    "db:migrate-sqlite": "bun run ../scripts/migrate-sqlite-to-postgres.ts",
    "db:migrate-legacy": "bun run server/src/db/migrate-legacy.ts",
    "db:audit": "bun run server/src/db/audit-legacy.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.10.0",
    "postgres": "^4.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^2.15.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tailwindcss/vite": "^4.1.13",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "drizzle-kit": "^0.31.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.8.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.0"
  }
}
